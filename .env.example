# Documentation only: the server reads variables from its environment.
# Do not commit real secrets. The app does not load a .env file.
PORT=8080
SEED=424242
ADMIN_SECRET=replace-with-a-long-random-string
NODE_OFFLINE_TIMEOUT_MS=10000
# Smoke Room integration (server-only values except VITE_SMOKE_BASE_URL).
NODES_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Local development alternative: path to an Ed25519 PKCS8 PEM file.
# NODES_JWT_PRIVATE_KEY_FILE=./data/smoke-nodes-private.pem
NODES_JWT_ISSUER=nodes
NODES_JWT_AUDIENCE=smoke-room
SMOKE_BASE_URL=http://localhost:10001
SMOKE_INTERNAL_API_SECRET=replace-with-a-shared-secret
# Vite exposes only variables prefixed with VITE_ to the browser.
VITE_SMOKE_BASE_URL=http://localhost:10001
# Supabase service credentials are backend-only and must never be exposed to Vite.
SUPABASE_URL=https://xusbdawjmbrfztqjfmwh.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_7XBJWyRN462dwtIiNEGV_Q_fP0UZQ_l
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key
VITE_SUPABASE_URL=https://xusbdawjmbrfztqjfmwh.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_7XBJWyRN462dwtIiNEGV_Q_fP0UZQ_l
# Optional: state/session snapshots live here (default ./data).
# DATA_DIR=./data
