{
  "name": "mumbai-network-garden",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cooperative multiplayer browser game for Devcon 8 Mumbai. Phase 1: pure deterministic rules engine.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "simulate": "tsx packages/testing/src/simulate.ts",
    "dev:server": "tsx watch apps/server/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "start": "tsx apps/server/src/main.ts",
    "loadtest": "tsx tools/loadtest/src/run.ts",
    "loadtest:isolated": "tsx tools/loadtest/src/isolated.ts",
    "state:reset": "tsx tools/reset/src/run.ts",
    "smoke": "tsx tools/smoke/src/run.ts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@supabase/realtime-js": "^2.118.0"
  }
}
